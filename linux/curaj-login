def load_config() -> dict:
    if not CONFIG_PATH.exists():
        sys.exit(f"missing config: {CONFIG_PATH}\n"
                 f"copy config.example.json there and fill it in "
                 f"(chmod 600).")
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except Exception as exc:
        sys.exit(f"cannot parse {CONFIG_PATH}: {exc}")
    for key in ("username", "password"):
        if not cfg.get(key):
            sys.exit(f"{CONFIG_PATH}: '{key}' is empty")
    cfg.setdefault("ssid", DEFAULT_SSID)
    cfg.setdefault("interface", "")
    return cfg


def resolve_device(cfg: dict, override: str | None) -> str | None:
    if override:
        return override
    if cfg.get("interface"):
        return cfg["interface"]
    return iface_for_ssid(cfg.get("ssid", DEFAULT_SSID))


def cmd_status(cfg: dict, args) -> int:
    dev = resolve_device(cfg, args.interface)
    if not dev:
        print(f"not connected to '{cfg.get('ssid', DEFAULT_SSID)}' "
              f"(no matching wifi interface)")
        return 2
    try:
        r = probe(dev)
    except OSError as exc:
        print(f"probe failed via {dev}: {exc}")
        return 1
    if r.status == 204:
        print(f"online via {dev}")
        return 0
    portal = find_portal(r, dev)
    print(f"blocked via {dev} (probe HTTP {r.status})")
    if portal:
        print(f"portal: {portal}")
    return 1


def cmd_once(cfg: dict, args) -> int:
    dev = resolve_device(cfg, args.interface)
    if not dev:
        print(f"not connected to '{cfg.get('ssid', DEFAULT_SSID)}'")
        return 2
    ok, msg = login(cfg, dev, verbose=True, force=args.force)
    print(("OK: " if ok else "FAIL: ") + msg)
    if not ok and is_session_limit(msg):
        print("Run: curaj-login sessions")
    return 0 if ok else 1


def cmd_logout(cfg: dict, args) -> int:
    dev = resolve_device(cfg, args.interface)
    if not dev:
        print("no matching wifi interface")
        return 2
    ok, msg = logout(dev, cfg)
    print(("logged out: " if ok else "still online: ") + msg)
    return 0 if ok else 1


def cmd_sessions(cfg: dict, args) -> int:
    dev = resolve_device(cfg, args.interface)
    if not dev:
        print(f"not connected to '{cfg.get('ssid', DEFAULT_SSID)}'")
        return 2

    if args.logout:
        ok, msg = logout_session(dev, cfg, args.logout)
        print(("logged out: " if ok else "FAIL: ") + msg)
        if not ok:
            return 1

        if not args.no_login:
            try:
                blocked = probe(dev).status != 204
            except OSError:
                blocked = False
            if blocked:
                print("[curaj-login] retrying normal login", flush=True)
                ok2, msg2 = login(cfg, dev, verbose=True)
                print(("OK: " if ok2 else "FAIL: ") + msg2)
                return 0 if ok2 else 1
        return 0

    ok, sessions, msg = list_sessions(dev, cfg)
    if not ok:
        print("FAIL: " + msg)
        return 1

    if args.json:
        print(json.dumps([asdict(s) for s in sessions], indent=2))
        return 0

    if not sessions:
        print("no active sessions")
        return 0

    print(f"{'ID':<12} {'STARTED':<20} {'DURATION':<10} "
          f"{'TOTAL':<10} ACCOUNT")
    for s in sessions:
        print(f"{s.sesno:<12} {s.start_time:<20} {s.duration:<10} "
              f"{s.total:<10} {s.account_id}")
    print("\nLog out one: curaj-login sessions --logout <ID>")
    return 0


def notify_session_limit(sessions: list[PortalSession]) -> None:
    """Best-effort desktop notification; the journal line is the fallback."""
    ids = ", ".join(s.sesno for s in sessions) or "unknown"
    title = "CURAJ: session limit reached"
    body = (f"Active sessions: {ids}. "
            f"Run: curaj-login sessions --logout <ID>")
    if shutil.which("notify-send"):
        try:
            subprocess.run(
                ["notify-send", "-a", "curaj-login", "-u", "normal",
                 title, body],
                timeout=3,
                check=False,
            )
        except Exception:
            pass


def cmd_watch(cfg: dict, args) -> int:
    ssid = cfg.get("ssid", DEFAULT_SSID)
    online_sleep = int(cfg.get("poll_online", 60))
    retry_sleep = int(cfg.get("poll_retry", 20))
    failures = 0
    limit_notified = False

    print(f"[curaj-login] watching for '{ssid}'", flush=True)

    while True:
        dev = resolve_device(cfg, args.interface)
        if not dev:
            time.sleep(30)
            continue

        try:
            r = probe(dev)
            if r.status == 204:
                if failures:
                    print(f"[curaj-login] online again via {dev}", flush=True)
                failures = 0
                limit_notified = False
                time.sleep(online_sleep)
                continue

            print(f"[curaj-login] captive portal detected on {dev}",
                  flush=True)
            ok, msg = login(cfg, dev, verbose=True)
            print(("[curaj-login] " + ("OK: " if ok else "FAIL: ") + msg),
                  flush=True)

            if ok:
                failures = 0
                limit_notified = False
                time.sleep(online_sleep)
            elif is_session_limit(msg):
                if not limit_notified:
                    ok_s, sessions, err = list_sessions(dev, cfg)
                    if ok_s:
                        print("[curaj-login] active portal sessions:",
                              flush=True)
                        for s in sessions:
                            print(f"[curaj-login]   {s.sesno}  "
                                  f"{s.start_time}  {s.duration}  "
                                  f"{s.total}", flush=True)
                        notify_session_limit(sessions)
                    else:
                        print(f"[curaj-login] could not list sessions: {err}",
                              flush=True)
                    limit_notified = True
                failures += 1
                time.sleep(min(retry_sleep * failures, 300))
            else:
                limit_notified = False
                failures += 1
                time.sleep(min(retry_sleep * failures, 300))
        except KeyboardInterrupt:
            return 0
        except Exception as exc:                     # never die in a loop
            failures += 1
            print(f"[curaj-login] error: {exc}", flush=True)
            time.sleep(min(retry_sleep * failures, 300))


def main() -> int:
    ap = argparse.ArgumentParser(prog="curaj-login",
                                 description="CURAJ CAMPUS CONNECT auto-login")
    ap.add_argument("-i", "--interface",
                    help="wifi interface (default: auto-detect by SSID)")
    ap.add_argument("-c", "--config", help="config path")
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("status", help="show whether the wifi is authenticated")
    p_once = sub.add_parser("once", help="run one login attempt")
    p_once.add_argument("--force", action="store_true",
                        help="POST even if the connection already works")
    sub.add_parser("watch", help="stay running and re-login forever")
    sub.add_parser("logout", help="log the current device out")
    p_sessions = sub.add_parser(
        "sessions", help="list active portal sessions or close one")
    p_sessions.add_argument("--json", action="store_true",
                            help="print the session list as JSON")
    p_sessions.add_argument("--logout", metavar="ID",
                            help="close the session with this ID")
    p_sessions.add_argument("--no-login", action="store_true",
                            help="do not retry login after --logout")

    args = ap.parse_args()

    global CONFIG_PATH
    if args.config:
        CONFIG_PATH = Path(args.config).expanduser()

    cfg = load_config()

    if args.cmd is None:
        args.cmd = "status"

    return {
        "status": cmd_status,
        "once": cmd_once,
        "watch": cmd_watch,
        "logout": cmd_logout,
        "sessions": cmd_sessions,
    }[args.cmd](cfg, args)


if __name__ == "__main__":
    sys.exit(main())
