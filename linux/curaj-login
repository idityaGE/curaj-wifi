#!/usr/bin/env python3
"""
curaj-login - automatic login for "CURAJ CAMPUS CONNECT"

Reverse-engineered flow (Inventum / RailWire captive portal):

  1. Any pre-auth HTTP request is intercepted by the gateway (Squid :3128)
     and answered with a "Please wait..." page whose meta-refresh points at

         http://122.252.242.93/userportal/?requesturi=...&ip=<client-ip>
              &mac=<client-mac>&nas=curaj&requestip=...&sc=<md5-token>
              &interface=cpeth3&locationid=<ap-name>

  2. GET that URL with a cookie jar -> 200 + JSESSIONID (the session now
     holds ip/mac/nas/sc context) and a tiny page that auto-POSTs login.do.

  3. POST /userportal/newlogin.do  (same JSESSIONID)

         username=<mobile>&password=<pw>&phone=0&type=2&jsonresponse=1

     -> {"errorKey":"success","errorMessage":"success_net"} on success.

  4. The NAS authorises the MAC/IP and normal traffic starts flowing.

Every socket in this client is bound to the Wi-Fi device with
SO_BINDTODEVICE.  Without that, a tethered phone / second default route
wins the route lookup and the portal looks unreachable (or a stale
"online" check gives a false positive).

Probes use a proxy-form (absolute-URI) request target.  The gateway Squid
intercepts all plain HTTP and, once a device is authenticated, rejects
browser-style origin-form requests with 400 ERR_INVALID_URL while proxying
absolute-URI requests normally - so "GET http://host/path HTTP/1.1" is the
only form that yields 204 for the online check in both auth states.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.parse
from dataclasses import asdict, dataclass, field
from http.client import HTTPConnection
from pathlib import Path

# --------------------------------------------------------------------------
# constants / defaults
# --------------------------------------------------------------------------

DEFAULT_SSID = "CURAJ CAMPUS CONNECT"
CHECK_URL = "http://connectivitycheck.gstatic.com/generate_204"
CHECK_HOST = "connectivitycheck.gstatic.com"
PORTAL_HOST = "122.252.242.93"
SELF_CARE_LOGIN_PAGE = ("/userportal/pages/usermedia/curaj/app/campus/ui/"
                        "login.jsp")
SELF_CARE_LOGIN = "/userportal/newlogin.do"
CURRENT_SESSIONS_PATH = "/userportal/currentSessions.do?from=Home"
NAS_LOGOUT_URL = "http://1.254.254.254/logout"
USER_AGENT = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
              "(KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36")

CONFIG_PATH = Path(os.environ.get("CURAJ_CONFIG",
                                  "~/.config/curaj-wifi/config.json")).expanduser()

PORTAL_URL_RE = re.compile(
    r"https?://[^\s\"'<>]+/userportal/\?[^\s\"'<>]+", re.I)
META_URL_RE = re.compile(r"(?i)URL=([^\"'>\s]+)")
JS_URL_RE = re.compile(r"""(?i)(?:window\.)?location(?:\.href)?\s*=\s*["']([^"']+)["']""")

# --------------------------------------------------------------------------
# HTTP over a device-bound socket
# --------------------------------------------------------------------------


class DeviceHTTPConnection(HTTPConnection):
    """HTTPConnection whose TCP socket is pinned to one network interface."""

    def __init__(self, host: str, port: int | None = None,
                 device: str | None = None, timeout: float = 8.0):
        super().__init__(host, port, timeout=timeout)
        self.device = device

    def connect(self) -> None:
        infos = socket.getaddrinfo(self.host, self.port,
                                   socket.AF_INET, socket.SOCK_STREAM)
        last: Exception | None = None
        for family, socktype, proto, _canon, sockaddr in infos:
            s = socket.socket(family, socktype, proto)
            try:
                if self.device:
                    s.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE,
                                 self.device.encode())
                s.settimeout(self.timeout)
                s.connect(sockaddr)
            except Exception as exc:          # try the next address
                last = exc
                s.close()
                continue
            self.sock = s
            return
        raise OSError(f"cannot connect to {self.host}:{self.port} "
                      f"via {self.device or 'any'}: {last}")


@dataclass
class HttpResponse:
    status: int
    headers: list[tuple[str, str]]
    body: bytes
    url: str

    def header(self, name: str) -> str | None:
        name = name.lower()
        for k, v in self.headers:
            if k.lower() == name:
                return v
        return None

    def header_all(self, name: str) -> list[str]:
        name = name.lower()
        return [v for k, v in self.headers if k.lower() == name]

    @property
    def text(self) -> str:
        return self.body.decode("utf-8", "replace")


def http_request(url: str, device: str | None, *, method: str = "GET",
                 body: bytes | None = None,
                 headers: dict[str, str] | None = None,
                 timeout: float = 8.0,
                 max_body: int = 1 << 20,
                 absolute_uri: bool = False) -> HttpResponse:
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "http":
        raise ValueError(f"only http:// is supported for the portal: {url}")

    conn = DeviceHTTPConnection(parts.hostname or "",
                                parts.port or 80, device, timeout)
    path = parts.path or "/"
    if parts.query:
        path += "?" + parts.query
    if absolute_uri:
        # Proxy-form request target. The campus Squid answers origin-form
        # requests ("GET /x HTTP/1.1" + Host:) with 400 ERR_INVALID_URL once
        # the device is authenticated, which would make every post-login
        # verification look "blocked". Sending the absolute URI works in
        # both auth states (pre-auth it still yields the splash page).
        path = f"http://{parts.netloc}{path}"

    hdrs = {
        "Host": parts.netloc,
        "User-Agent": USER_AGENT,
        "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
        "Connection": "close",
    }
    if headers:
        hdrs.update(headers)

    try:
        conn.request(method, path, body=body, headers=hdrs)
        resp = conn.getresponse()
        data = resp.read(max_body)
        return HttpResponse(resp.status, list(resp.getheaders()), data, url)
    finally:
        conn.close()


# --------------------------------------------------------------------------
# interface / SSID discovery
# --------------------------------------------------------------------------


def _run(cmd: list[str]) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=5).stdout
    except Exception:
        return ""


def iface_for_ssid(ssid: str) -> str | None:
    """Return the wireless interface currently associated with `ssid`."""
    # nmcli: DEVICE:TYPE:STATE  +  GENERAL.CONNECTION
    for line in _run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE",
                      "device"]).splitlines():
        bits = line.split(":")
        if len(bits) < 3:
            continue
        dev, typ, state = bits[0], bits[1], bits[2]
        if typ != "wifi" or not state.startswith("connected"):
            continue
        info = _run(["nmcli", "-t", "-f", "GENERAL.CONNECTION",
                     "device", "show", dev])
        name = info.split(":", 1)[1].strip() if ":" in info else ""
        if name == ssid:
            return dev

    # fallback: iw
    for dev in os.listdir("/sys/class/net"):
        if not os.path.isdir(f"/sys/class/net/{dev}/wireless"):
            continue
        link = _run(["iw", "dev", dev, "link"])
        m = re.search(r"^SSID:\s*(.+)$", link, re.M)
        if m and m.group(1).strip() == ssid:
            return dev
    return None


# --------------------------------------------------------------------------
# portal discovery / login
# --------------------------------------------------------------------------


def probe(device: str | None) -> HttpResponse:
    """204 = authenticated, anything else = intercepted/blocked.

    Sent as a proxy-form (absolute-URI) request: after login the gateway
    Squid rejects origin-form requests with 400 ERR_INVALID_URL, which would
    make an authenticated device look blocked forever. One retry absorbs the
    short blackhole while the NAS tears a session down.
    """
    last: OSError | None = None
    for _ in range(3):
        try:
            return http_request(CHECK_URL, device,
                                headers={"Host": CHECK_HOST}, timeout=6.0,
                                absolute_uri=True)
        except OSError as exc:
            last = exc
            time.sleep(0.5)
    raise last  # type: ignore[misc]


def find_portal(resp: HttpResponse, device: str | None) -> str | None:
    """Pull the userportal URL out of a redirect / meta-refresh / JS page."""
    candidates: list[str] = []

    loc = resp.header("Location")
    if loc:
        candidates.append(urllib.parse.urljoin(resp.url, loc))

    text = resp.text
    for rx in (META_URL_RE, JS_URL_RE):
        for m in rx.finditer(text):
            candidates.append(urllib.parse.urljoin(resp.url, m.group(1)))

    candidates.extend(m.group(0) for m in PORTAL_URL_RE.finditer(text))

    for url in candidates:
        url = url.replace(" ", "%20")
        if "/userportal" not in url and "1.254.254.254" not in url:
            continue

        # 1.254.254.254 is the NAS splash: it re-redirects to the real portal
        if urllib.parse.urlsplit(url).hostname == "1.254.254.254":
            try:
                hop = http_request(url, device, timeout=6.0)
                deeper = find_portal(hop, device)
                if deeper and "1.254.254.254" not in deeper:
                    return deeper
            except OSError:
                pass
        return url
    # If response contains portal host even if regex missed, try to find it
    m = re.search(r"(http://122\.252\.242\.93[^\s\"'<>]+)", resp.text)
    if m:
        return m.group(1).replace(" ", "%20")
    return None


def _query(url: str) -> dict[str, str]:
    q = urllib.parse.parse_qs(urllib.parse.urlsplit(url).query)
    return {k: v[0] for k, v in q.items() if v}


def allowed_portal_hosts(config: dict | None) -> set[str]:
    """Hosts we are willing to send the portal password to.

    A hostile Wi-Fi can serve a fake /userportal page.  Pinning the host means
    the password can only go to the real campus portal.
    """
    cfg = config or {}
    hosts = cfg.get("portal_hosts") or cfg.get("portal_host") or [PORTAL_HOST]
    if isinstance(hosts, str):
        hosts = [hosts]
    return {str(h).strip().lower() for h in hosts if str(h).strip()}


def trusted_portal(url: str, config: dict | None) -> bool:
    host = (urllib.parse.urlsplit(url).hostname or "").lower()
    return host in allowed_portal_hosts(config)


def _json(resp: HttpResponse) -> dict:
    try:
        return json.loads(resp.text)
    except Exception:
        return {}


def is_session_limit(message: str) -> bool:
    """The portal's wording is inconsistent, so match the stable phrases."""
    text = message.lower()
    return (
        "maximum session" in text
        or "session allowed reached" in text
        or "session limit" in text
        or "maximum of 2" in text
        or "subscription allow" in text
    )


@dataclass
class PortalSession:
    """One row from /userportal/currentSessions.do?from=Home."""

    sesno: str
    name: str
    account_id: str
    rate_plan: str
    net_id: str
    start_time: str
    duration: str
    upload: str
    download: str
    total: str

    def display(self) -> str:
        return (f"{self.start_time}  {self.duration}  "
                f"{self.total}  {self.name} ({self.account_id})")


def _cookie_from(resp: HttpResponse) -> str | None:
    for value in resp.header_all("Set-Cookie"):
        if value.upper().startswith("JSESSIONID="):
            return value.split(";", 1)[0]
    return None


def _clean_cell(raw: str) -> str:
    text = re.sub(r"(?is)<[^>]+>", " ", raw)
    text = html.unescape(text)
    return re.sub(r"\s+", " ", text).strip()


def parse_sessions(page: str) -> list[PortalSession]:
    """Parse the current-session table without an HTML parser dependency."""
    sessions: list[PortalSession] = []
    for row_match in re.finditer(r"(?is)<tr[^>]*>(.*?)</tr>", page):
        row = row_match.group(1)
        id_match = re.search(r"callClose\((\d+)\)", row)
        if not id_match:
            continue
        cells = [_clean_cell(c) for c in
                 re.findall(r"(?is)<td[^>]*>(.*?)</td>", row)]
        if len(cells) < 9:
            continue
        cells += [""] * (9 - len(cells))
        sessions.append(PortalSession(
            sesno=id_match.group(1),
            name=cells[0],
            account_id=cells[1],
            rate_plan=cells[2],
            net_id=cells[3],
            start_time=cells[4],
            duration=cells[5],
            upload=cells[6],
            download=cells[7],
            total=cells[8],
        ))
    return sessions


def _portal_context_cookie(device: str, config: dict) -> str | None:
    """Return a JSESSIONID bound to this client's portal context.

    The self-care page on its own issues a cookie that can *list* sessions but
    cannot *close* them: ``logout.do`` answers 302 to the NAS splash and the
    session stays alive.  The cookie obtained from the portal splash URL (the
    same first hop as the normal login) carries ip/mac/nas/sc context, and
    that is what the portal checks before allowing a session close.
    """
    portal = portal_url_any(device)
    if not portal or not trusted_portal(portal, config):
        return None
    try:
        response = http_request(portal, device, timeout=8.0)
    except OSError:
        return None
    return _cookie_from(response)


def _self_care_cookie(device: str, config: dict) -> str | None:
    """Open a portal *self-care* session.

    `type=1` is the account-management login used by the self-care page.  It
    is deliberately different from the internet login (`type=2`): it lets us
    list sessions even when the account is already at its two-session limit,
    and it does not create another internet session.

    Authenticate on top of a context cookie whenever possible; without it the
    portal only supports listing, not closing, a session.
    """
    base = f"http://{PORTAL_HOST}"
    login_page = base + SELF_CARE_LOGIN_PAGE
    cookie = _portal_context_cookie(device, config)
    if not cookie:
        # Fallback for listing when the NAS splash is unavailable.  Closing a
        # session will fail verification with this cookie, which is safer than
        # pretending the close worked.
        try:
            first = http_request(login_page, device, timeout=8.0)
        except OSError:
            return None
        cookie = _cookie_from(first)
        if not cookie:
            return None

    body = urllib.parse.urlencode({
        "generatePassword": "true",
        "phone": "0",
        "type": "1",
        "username": config["username"],
        "password": config["password"],
    }).encode()
    headers = {
        "Cookie": cookie,
        "Content-Type": "application/x-www-form-urlencoded",
        "Referer": login_page,
        "Origin": base,
    }
    second = http_request(base + SELF_CARE_LOGIN, device, method="POST",
                          body=body, headers=headers, timeout=10.0)
    return _cookie_from(second) or cookie


def _fetch_sessions_page(device: str, cookie: str) -> HttpResponse:
    return http_request(
        f"http://{PORTAL_HOST}{CURRENT_SESSIONS_PATH}", device,
        headers={
            "Cookie": cookie,
            "Referer": f"http://{PORTAL_HOST}/userportal/home.do?from=Home",
        },
        timeout=8.0,
    )


def _self_care_snapshot(device: str, config: dict
                        ) -> tuple[bool, str | None, list[PortalSession], str]:
    """Authenticate to self-care and return (ok, cookie, sessions, message)."""
    try:
        cookie = _self_care_cookie(device, config)
    except OSError as exc:
        return False, None, [], f"self-care login failed: {exc}"
    if not cookie:
        return False, None, [], "self-care login issued no JSESSIONID"

    try:
        page = _fetch_sessions_page(device, cookie)
        if "session has been expired" in page.text.lower():
            # The cookie can expire independently of the NAS session.
            cookie = _self_care_cookie(device, config)
            if not cookie:
                return False, None, [], "self-care session expired"
            page = _fetch_sessions_page(device, cookie)
    except OSError as exc:
        return False, None, [], f"session list failed: {exc}"

    if "session has been expired" in page.text.lower():
        return False, None, [], ("self-care login failed "
                                 "(check the saved password)")
    if not re.search(r"current session|items found", page.text, re.I):
        snippet = re.sub(r"\s+", " ", page.text).strip()[:160]
        return False, None, [], f"unexpected session page: {snippet}"

    return True, cookie, parse_sessions(page.text), ""


def list_sessions(device: str, config: dict
                  ) -> tuple[bool, list[PortalSession], str]:
    if not trusted_portal(f"http://{PORTAL_HOST}/userportal", config):
        return False, [], f"untrusted portal host {PORTAL_HOST!r}"
    ok, _cookie, sessions, message = _self_care_snapshot(device, config)
    return ok, sessions, message


def logout_session(device: str, config: dict, sesno: str
                   ) -> tuple[bool, str]:
    """Close one specific portal session, then confirm it disappeared."""
    if not re.fullmatch(r"\d+", sesno):
        return False, "session id must be numeric"
    if not trusted_portal(f"http://{PORTAL_HOST}/userportal", config):
        return False, f"untrusted portal host {PORTAL_HOST!r}"

    ok, cookie, sessions, message = _self_care_snapshot(device, config)
    if not ok or not cookie:
        return False, message or "could not open self-care session"
    if not any(s.sesno == sesno for s in sessions):
        return False, f"session {sesno} is not active"

    url = (f"http://{PORTAL_HOST}/userportal/logout.do"
           f"?from=curses&sesno={sesno}")
    try:
        response = http_request(
            url, device, method="POST", body=b"",
            headers={
                "Cookie": cookie,
                "Content-Type": "application/x-www-form-urlencoded",
                "Referer": f"http://{PORTAL_HOST}{CURRENT_SESSIONS_PATH}",
                "Origin": f"http://{PORTAL_HOST}",
            },
            timeout=8.0,
        )
    except OSError as exc:
        return False, f"logout request failed: {exc}"

    # The server normally answers 200 when it really closed the session.  An
    # invalid/unauthorised id instead gets 302 to http://1.254.254.254?N=...
    # and leaves the session alive, so verify against the live list.
    for _ in range(4):
        time.sleep(0.8)
        try:
            page = _fetch_sessions_page(device, cookie)
        except OSError:
            page = None

        if page is not None:
            lowered = page.text.lower()
            if "session has been expired" not in lowered and re.search(
                    r"current session|items found", page.text, re.I):
                after = parse_sessions(page.text)
                if all(s.sesno != sesno for s in after):
                    return True, f"logged out session {sesno}"
                continue

        # The context/self-care cookie expired; open a fresh one and re-check.
        ok2, cookie2, after, _message2 = _self_care_snapshot(device, config)
        if ok2 and all(s.sesno != sesno for s in after):
            return True, f"logged out session {sesno}"
        if ok2 and cookie2:
            cookie = cookie2

    return False, (f"portal did not close session {sesno} "
                   f"(HTTP {response.status})")


def login(config: dict, device: str, *, verbose: bool = True,
          force: bool = False, _depth: int = 0) -> tuple[bool, str]:
    """Run the whole pre-auth -> portal -> newlogin.do flow."""

    def log(msg: str) -> None:
        if verbose:
            print(f"[curaj-login] {msg}", flush=True)

    try:
        first = probe(device)
    except OSError as exc:
        return False, f"connectivity probe failed on {device}: {exc}"
    if first.status == 204 and not force:
        return True, "already online"

    portal = find_portal(first, device)
    if not portal:
        if first.status == 204:
            return True, "already online (no portal page to post to)"
        # Fallback: NAS splash often still works when captive check is broken (e.g. HTTP 400)
        portal = portal_url_any(device)
        if not portal and first.text:
            # Try to find portal URL directly in response body
            m = re.search(r"(https?://122\.252\.242\.93[^\s\"'<>]+/userportal/[^\s\"'<>]+)", first.text)
            if m:
                portal = m.group(1).replace(" ", "%20")

    log(f"portal: {portal}")
    if not trusted_portal(portal, config):
        host = urllib.parse.urlsplit(portal).hostname
        return False, (f"refusing to send credentials to untrusted portal "
                       f"host {host!r}")
    params = _query(portal)
    parts = urllib.parse.urlsplit(portal)
    netloc = parts.netloc or PORTAL_HOST
    requesturi = params.get("requesturi", CHECK_URL)

    # 1. establish the portal session (JSESSIONID carries ip/mac/sc context)
    try:
        splash = http_request(portal, device, timeout=8.0)
    except OSError as exc:
        return False, f"portal unreachable: {exc}"

    cookie = None
    for value in splash.header_all("Set-Cookie"):
        if value.upper().startswith("JSESSIONID="):
            cookie = value.split(";", 1)[0]
            break

    if not cookie:
        return False, "portal did not issue a JSESSIONID"

    common = {
        "Cookie": cookie,
        "Referer": f"http://{netloc}/userportal/pages/usermedia/curaj/app/"
                   f"campus/ui/login.html",
        "Origin": f"http://{netloc}",
    }

    # 2. same hop the browser makes: login.do -> SPA
    try:
        http_request(
            f"http://{netloc}/userportal/login.do?requesturi="
            + urllib.parse.quote(requesturi, safe=""),
            device, method="POST", body=b"", headers=common, timeout=8.0)
    except OSError:
        pass  # not strictly required; newlogin.do is what matters

    # 3. actual credential POST
    body = urllib.parse.urlencode({
        "username": config["username"],
        "password": config["password"],
        "phone": "0",
        "type": "2",
        "jsonresponse": "1",
    }).encode()

    hdrs = dict(common)
    hdrs["Content-Type"] = "application/x-www-form-urlencoded"

    log(f"POST http://{netloc}/userportal/newlogin.do "
        f"(user {config['username']})")

    try:
        resp = http_request(f"http://{netloc}/userportal/newlogin.do",
                            device, method="POST", body=body,
                            headers=hdrs, timeout=10.0)
    except OSError as exc:
        return False, f"login POST failed: {exc}"

    data = _json(resp)
    log(f"portal says: {data or resp.text[:200]!r}")

    ok = (data.get("errorKey") == "success"
          or data.get("errorMessage") == "success_net")

    # The account is limited to two simultaneous internet sessions.  Do not
    # auto-kick anything: the user must choose a session to close.
    portal_message = " ".join(str(data.get(k, "")) for k in
                              ("errorMessage", "errorKey")) + " " + resp.text[:300]
    if not ok and is_session_limit(portal_message):
        log("portal session limit reached")
        return False, "session limit reached (2 active)"

    # "redirect_to_nas" / "Session already running" mean the NAS still holds a
    # half-session (or the request lost the sc context).  Kill the portal
    # session with our cookie, then the NAS one, and retry exactly once.
    stale = (data.get("errorKey") == "redirect_to_nas"
             or "already running" in str(data.get("errorMessage", "")).lower())
    if not ok and stale and _depth < 1:
        log("portal reports an existing/stale session; logging it out and retrying")
        for url, hdrs in (
            (f"http://{netloc}/userportal/logout.do", {"Cookie": cookie}),
            (NAS_LOGOUT_URL, None),
        ):
            try:
                http_request(url, device, headers=hdrs, timeout=5.0)
            except OSError:
                pass
        time.sleep(2.0)
        try:
            r = probe(device)
        except OSError:
            r = None
        if r is not None and r.status == 204:
            return True, "logged in (stale session cleared)"
        portal2 = find_portal(r, device) if r is not None else None
        if portal2:
            return login(config, device, verbose=verbose,
                         force=False, _depth=_depth + 1)

    if not ok:
        msg = (data.get("errorMessage") or data.get("errorKey")
               or resp.text.strip()[:200] or f"HTTP {resp.status}")
        return False, f"login rejected: {msg}"

    # 4. verify that the NAS actually let traffic through.  The NAS can
    # blackhole briefly right after a session change, so tolerate probes
    # that time out and keep polling.
    for _ in range(6):
        time.sleep(1.5)
        try:
            if probe(device).status == 204:
                return True, "logged in"
        except OSError:
            continue
    # If verification fails but portal said success, try a clean logout/retry once
    if _depth < 1:
        log("portal said success but internet still blocked; attempting clean logout and retry")
        try:
            logout(device, config)
        except Exception:
            pass
        time.sleep(3.0)
        try:
            r = probe(device)
        except OSError:
            r = None
        if r is not None and r.status == 204:
            return True, "logged in (after cleanup)"
        portal2 = ((find_portal(r, device) if r is not None else None)
                   or portal_url_any(device))
        if portal2:
            return login(config, device, verbose=verbose,
                         force=False, _depth=_depth + 1)
    return False, "portal said success but internet is still blocked"


def portal_url_any(device: str) -> str | None:
    """Find a userportal URL even when the NAS already considers us online.

    The NAS splash at 1.254.254.254 answers in both auth states and hands out
    a fresh sc token, so it is the reliable discovery point for logout.
    """
    try:
        r = probe(device)
        if r.status != 204:
            found = find_portal(r, device)
            if found:
                return found
    except OSError:
        pass

    # /login is the reliable splash hop; / sometimes blackholes while online.
    for splash in ("http://1.254.254.254/login", "http://1.254.254.254/"):
        try:
            found = find_portal(http_request(splash, device, timeout=6.0),
                                device)
        except OSError:
            continue
        if found and "/userportal" in found:
            return found
    return None


def _session_cookie(portal: str, device: str) -> str | None:
    r = http_request(portal, device, timeout=8.0)
    for value in r.header_all("Set-Cookie"):
        if value.upper().startswith("JSESSIONID="):
            return value.split(";", 1)[0]
    return None


def logout(device: str, config: dict | None = None) -> tuple[bool, str]:
    """Real logout.

    A bare GET /logout or /logout.do is a no-op: the portal can only tear the
    session down when the request carries the JSESSIONID that was bound to the
    NAS session by newlogin.do.  So: discover the portal (works while online
    too), open a session, bind it with the credentials, then logout.do.
    """
    msgs: list[str] = []
    portal = portal_url_any(device)

    if portal and not trusted_portal(portal, config):
        host = urllib.parse.urlsplit(portal).hostname
        msgs.append(f"untrusted portal host {host!r}")
        portal = None

    if not portal:
        msgs.append("no portal URL")
    else:
        netloc = urllib.parse.urlsplit(portal).netloc or PORTAL_HOST
        try:
            cookie = _session_cookie(portal, device)
            msgs.append(f"session: {'JSESSIONID' if cookie else 'none'}")
        except OSError as exc:
            cookie = None
            msgs.append(f"session: {exc}")

        if cookie:
            # "Session already running" is the normal answer here; the useful
            # side effect is that the fresh JSESSIONID is now bound to the
            # live NAS session, which is what makes logout.do work.
            if config and config.get("username"):
                body = urllib.parse.urlencode({
                    "username": config["username"],
                    "password": config["password"],
                    "phone": "0",
                    "type": "2",
                    "jsonresponse": "1",
                }).encode()
                try:
                    http_request(
                        f"http://{netloc}/userportal/newlogin.do",
                        device, method="POST", body=body,
                        headers={
                            "Cookie": cookie,
                            "Content-Type": "application/x-www-form-urlencoded",
                            "Referer": f"http://{netloc}/userportal/pages/"
                                       f"usermedia/curaj/app/campus/ui/login.html",
                            "Origin": f"http://{netloc}",
                        },
                        timeout=8.0)
                except OSError:
                    pass

            try:
                r = http_request(
                    f"http://{netloc}/userportal/logout.do",
                    device, headers={"Cookie": cookie}, timeout=6.0)
                msgs.append(f"logout.do -> {r.status}")
            except OSError as exc:
                msgs.append(f"logout.do -> {exc}")

    try:
        r = http_request(NAS_LOGOUT_URL, device, timeout=6.0)
        msgs.append(f"nas/logout -> {r.status}")
    except OSError as exc:
        msgs.append(f"nas/logout -> {exc}")

    time.sleep(1.5)
    try:
        online = probe(device).status == 204
    except OSError:
        online = False
    return (not online), "; ".join(msgs)


